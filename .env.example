# Copy to .env.local. Never commit secrets.
# The mode is intentionally explicit. fixture is offline and never inferred.
WAFFO_MODE=fixture

# Required for waffo-test / waffo-prod.
WAFFO_MERCHANT_ID=
WAFFO_STORE_ID=
WAFFO_PRODUCT_ID=
WAFFO_PRIVATE_KEY=
WAFFO_PRIVATE_KEY_FILE=
WAFFO_API_BASE=https://api.waffo.ai
# Live mode requires a public HTTPS origin; replace this with the deployed host.
PUBLIC_BASE_URL=https://pitch-first-slot.app
# waffo-prod requires an explicit deployment-provided durable path.
DATABASE_PATH=

# Explicit environment-specific RSA webhook verification keys.
WAFFO_WEBHOOK_TEST_PUBLIC_KEY=
WAFFO_WEBHOOK_PROD_PUBLIC_KEY=

# Legacy selector variables are rejected by the runtime. Do not configure them.
